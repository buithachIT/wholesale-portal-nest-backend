# Copy to `.env` on the VPS. Do not commit `.env`.
# Local dev: keep DEV_DB_* and leave DATABASE_URL unset (or point at localhost).

PORT=3000
NODE_ENV=production
APP_URL=https://api.example.com
API_PUBLISH_PORT=3000
CORS_ORIGIN=https://app.example.com
COOKIE_SAMESITE=none

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=b2b_logistics_db

# Docker Compose service hostname is `postgres`, not localhost.
DATABASE_URL=postgresql://postgres:change-me@postgres:5432/b2b_logistics_db?schema=public

DEV_DB_HOST=localhost
DEV_DB_PORT=5432
DEV_DB_USER=postgres
DEV_DB_PASSWORD=postgrespassword
DEV_DB_NAME=b2b_logistics_db

JWT_ACCESS_SECRET=generate-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=generate-another-long-random-string
JWT_REFRESH_EXPIRES_IN=7d
