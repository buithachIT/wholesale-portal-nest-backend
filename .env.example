# Copy to `.env` on the VPS. Do not commit `.env`.

PORT=3000
NODE_ENV=production
APP_URL=https://api.your-domain.com
API_PUBLISH_PORT=127.0.0.1:3010
CORS_ORIGIN=https://app.your-domain.com
COOKIE_SAMESITE=none

# Host = Postgres container name on the same Docker network (not localhost).
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@ecommerce-postgres:5432/b2b_logistics_db?schema=public

JWT_ACCESS_SECRET=generate-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=generate-another-long-random-string
JWT_REFRESH_EXPIRES_IN=7d
